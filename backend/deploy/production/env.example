# Copy to /opt/claw/.env, fill every blank secret, then chmod 600.
# Generate password-like values with: openssl rand -hex 32
# Hex values avoid reserved characters in the MySQL DSN.
V2_MYSQL_DATABASE=claw_v2
V2_MYSQL_USER=claw_v2
V2_MYSQL_PASSWORD=
V2_MYSQL_ROOT_PASSWORD=
V2_REDIS_PASSWORD=

V2_MINIO_ACCESS_KEY=
V2_MINIO_SECRET_KEY=
V2_MINIO_REGION=us-east-1
# Exact public authority used by browsers, without a scheme. Include the port
# when it is not 80/443; MinIO presigned URLs depend on this value.
V2_MINIO_PUBLIC_ENDPOINT=tmpai2.com
V2_MINIO_PUBLIC_USE_TLS=true
V2_MINIO_CONSOLE_PORT=29001

V2_PUBLIC_URL=https://tmpai2.com
V2_DATA_ENCRYPTION_KEY=
V2_LEGACY_AUTHCODE=

V2_SPORTS_API_BASE_URL=https://v3.football.api-sports.io
V2_SPORTS_API_KEY=
V2_SPORTS_LIVE_INTERVAL=5m
V2_SPORTS_CATALOG_INTERVAL=6h
V2_SPORTS_ODDS_INTERVAL=3h

V2_HTTP_BIND=0.0.0.0
V2_HTTP_PORT=80
V2_HTTPS_BIND=0.0.0.0
V2_HTTPS_PORT=443

# Cloudflare Origin Certificate files on the server. Keep the certificate and
# private key outside the Git checkout. The Compose stack mounts them read-only.
V2_TLS_CERT_FILE=/opt/claw-secrets/tls/tmpai2.com-origin.crt
V2_TLS_KEY_FILE=/opt/claw-secrets/tls/tmpai2.com-origin.key

# Production sets Secure cookies and the origin terminates TLS on port 443.
V2_ADMIN_RUNTIME_ENV=production
V2_SUPPORT_RUNTIME_ENV=production

# One-time bootstrap values. Leave blank during normal deployments, fill them
# only while running the bootstrap profile, then remove them from /opt/claw/.env.
V2_ADMIN_USERNAME=
V2_ADMIN_PASSWORD=
V2_ADMIN_DISPLAY_NAME=系统管理员

V2_SUPPORT_AGENT_USERNAME=
V2_SUPPORT_AGENT_PASSWORD=
V2_SUPPORT_AGENT_DISPLAY_NAME=客服主管
V2_SUPPORT_AGENT_ROLE=support_supervisor

V2_APP_USER_USERNAME=
V2_APP_USER_PASSWORD=
V2_APP_USER_NICKNAME=体验用户
V2_APP_USER_EMAIL=
V2_APP_USER_COUNTRY_CODE=86

V2_VIRTUAL_LIVE_USERS=300
V2_DOUYIN_ROOM_ID=433645971956
V2_VIRTUAL_LIVE_TITLE=晚晚日记·轻松直播间
V2_VIRTUAL_LIVE_CATEGORY=聊天
