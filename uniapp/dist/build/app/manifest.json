{
  "@platforms": [
    "android",
    "iPhone",
    "iPad"
  ],
  "id": "__UNI__D917A6C",
  "name": "星域",
  "version": {
    "name": "8.2.1",
    "code": "217"
  },
  "description": "星域 uni-app Android MVP",
  "developer": {
    "name": "",
    "email": "",
    "url": ""
  },
  "permissions": {
    "Camera": {},
    "Record": {},
    "VideoPlayer": {},
    "Audio": {},
    "OAuth": {},
    "Share": {},
    "SQLite": {},
    "UniNView": {
      "description": "UniNView原生渲染"
    }
  },
  "plus": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "splashscreen": {
      "target": "id:1",
      "autoclose": true,
      "waiting": true,
      "delay": 0
    },
    "popGesture": "close",
    "launchwebview": {
      "id": "1",
      "kernel": "WKWebview"
    },
    "usingComponents": true,
    "nvueCompiler": "uni-app",
    "compilerVersion": 3,
    "distribute": {
      "icons": {
        "android": {
          "hdpi": "static/brand/icon.png",
          "xhdpi": "static/brand/icon.png",
          "xxhdpi": "static/brand/icon.png",
          "xxxhdpi": "static/brand/icon.png"
        }
      },
      "google": {
        "packagename": "com.yunbao.phonelive",
        "minSdkVersion": 29,
        "targetSdkVersion": 36,
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
          "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
          "<uses-permission android:name=\"android.permission.CHANGE_WIFI_STATE\"/>",
          "<uses-permission android:name=\"android.permission.CAMERA\"/>",
          "<uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>",
          "<uses-permission android:name=\"android.permission.READ_MEDIA_IMAGES\"/>",
          "<uses-permission android:name=\"android.permission.READ_MEDIA_VIDEO\"/>",
          "<uses-permission android:name=\"android.permission.MODIFY_AUDIO_SETTINGS\"/>",
          "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
          "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
          "<uses-permission android:name=\"android.permission.FOREGROUND_SERVICE\"/>",
          "<uses-permission android:name=\"android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION\"/>",
          "<uses-permission android:name=\"android.permission.FOREGROUND_SERVICE_MICROPHONE\"/>",
          "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>",
          "<uses-permission android:name=\"android.permission.READ_EXTERNAL_STORAGE\" android:maxSdkVersion=\"32\"/>",
          "<uses-permission android:name=\"android.permission.SYSTEM_ALERT_WINDOW\"/>",
          "<uses-permission android:name=\"android.permission.MANAGE_EXTERNAL_STORAGE\"/>",
          "<uses-permission android:name=\"android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS\"/>",
          "<uses-permission android:name=\"android.permission.REQUEST_INSTALL_PACKAGES\"/>"
        ]
      },
      "apple": {
        "privacyDescription": {
          "NSMicrophoneUsageDescription": "用于发送语音消息和发布语音动态",
          "NSCameraUsageDescription": "用于拍摄头像、动态图片和视频",
          "NSPhotoLibraryUsageDescription": "用于选择头像、动态图片和视频",
          "NSPhotoLibraryAddUsageDescription": "用于保存聊天和直播中的图片与视频"
        },
        "dSYMs": false
      },
      "plugins": {
        "audio": {
          "mp3": {
            "description": "Android平台录音支持MP3格式文件"
          }
        }
      }
    },
    "statusbar": {
      "immersed": "supportedDevice",
      "style": "dark",
      "background": "#ffffff"
    },
    "allowsInlineMediaPlayback": true,
    "safearea": {
      "background": "#ffffff",
      "bottom": {
        "offset": "auto"
      }
    },
    "uni-app": {
      "control": "uni-v3",
      "vueVersion": "3",
      "compilerVersion": "5.23",
      "nvueCompiler": "uni-app",
      "renderer": "auto",
      "nvue": {
        "flex-direction": "column"
      },
      "nvueLaunchMode": "normal",
      "webView": {
        "minUserAgentVersion": "49.0"
      }
    },
    "tabBar": {
      "position": "bottom",
      "color": "#9AA0B0",
      "selectedColor": "#FF4D6E",
      "borderStyle": "rgba(0,0,0,0.4)",
      "blurEffect": "none",
      "fontSize": "10px",
      "iconWidth": "24px",
      "spacing": "3px",
      "height": "50px",
      "list": [
        {
          "pagePath": "pages/tabbar/live/index",
          "text": "Home",
          "iconPath": "/static/tabbar/home.png",
          "selectedIconPath": "/static/tabbar/home-active.png",
          "textLocales": {
            "en": "Home",
            "ja": "ホーム",
            "ko": "홈",
            "zh-Hans": "首页"
          }
        },
        {
          "pagePath": "pages/tabbar/game/index",
          "text": "Games",
          "iconPath": "/static/tabbar/game.png",
          "selectedIconPath": "/static/tabbar/game-active.png",
          "textLocales": {
            "en": "Games",
            "ja": "ゲーム",
            "ko": "게임",
            "zh-Hans": "游戏"
          }
        },
        {
          "pagePath": "pages/tabbar/sports/index",
          "text": "Sports",
          "iconPath": "/static/tabbar/sports.png",
          "selectedIconPath": "/static/tabbar/sports-active.png",
          "textLocales": {
            "en": "Sports",
            "ja": "スポーツ",
            "ko": "스포츠",
            "zh-Hans": "体育"
          }
        },
        {
          "pagePath": "pages/tabbar/dynamic/index",
          "text": "Feed",
          "iconPath": "/static/tabbar/dynamic.png",
          "selectedIconPath": "/static/tabbar/dynamic-active.png",
          "textLocales": {
            "en": "Feed",
            "ja": "フィード",
            "ko": "피드",
            "zh-Hans": "动态"
          }
        },
        {
          "pagePath": "pages/tabbar/me/index",
          "text": "Me",
          "iconPath": "/static/tabbar/me.png",
          "selectedIconPath": "/static/tabbar/me-active.png",
          "textLocales": {
            "en": "Me",
            "ja": "マイページ",
            "ko": "마이",
            "zh-Hans": "我的"
          }
        }
      ],
      "backgroundColor": "#ffffff",
      "selectedIndex": 0,
      "shown": true
    }
  },
  "app-harmony": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "safearea": {
      "background": "#ffffff",
      "bottom": {
        "offset": "auto"
      }
    }
  },
  "launch_path": "__uniappview.html",
  "fallbackLocale": "en"
}