{
  "name": "claw-uniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "uni -p app",
    "build:h5": "uni build -p h5 && sh scripts/normalize-h5-permissions.sh",
    "build:app-plus": "npm run validate:native && uni build -p app",
    "typecheck": "vue-tsc --noEmit",
    "validate:native": "node scripts/validate-native-capabilities.mjs",
    "build:wgt": "npm run validate:native && node scripts/build-wgt.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-app-plus": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "crypto-js": "^4.2.0",
    "hls.js": "^1.6.16",
    "spark-md5": "3.0.2",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.10.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  }
}
